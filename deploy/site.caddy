# vodja's route in the shared proxy. deploy.sh installs it as /opt/proxy/sites/vodja.caddy and reloads the proxy,
# which then gets the certificate itself. vodja-web is the `web` container and vodja-api the `api` container of
# /opt/vodja (deploy/compose.yml).
vodja.miklavic.si {
	handle /api/* {
		reverse_proxy vodja-api:3000
	}
	handle {
		reverse_proxy vodja-web:80
	}
}
